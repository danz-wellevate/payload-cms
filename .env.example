DATABASE_URL=file:./payload-cms.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Code playground (/playground). Defaults to the free public Judge0 CE instance.
# For production, use a self-hosted Judge0 or RapidAPI (https://judge0-ce.p.rapidapi.com).
# JUDGE0_API_URL=https://ce.judge0.com
# JUDGE0_API_KEY=

# Public URL of the site, used in the applicant set-password email link.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# SMTP for applicant emails. If unset, emails are printed to the server console.
# Free option: Gmail (500/day) with an App Password from https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM_NAME=Coding Exam

# Hiring workflow (/careers). Claude reviews each resume against the job posting.
# Get a key at https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=
# Time zone for interview and assessment times in emails and the booking page.
# HIRING_TIME_ZONE=Asia/Manila
